---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kontakt">
  <h1>Kontakt</h1>
  <p>
    Vill du veta mer om ett verk, fråga om pris eller bara säga hej?
    Skicka ett mail — jag svarar så fort jag kan.
  </p>
  <p class="rad">
    <a class="mail" href="mailto:livi@livdue.com">livi@livdue.com</a>
  </p>
  <p class="muted adress">
    Liv Due Art<br />
    Trolldalsvägen 4a<br />
    181 29 Lidingö
  </p>
</Layout>

<style>
  h1 {
    font-size: 22px;
    margin: 8px 0 12px;
  }
  p {
    max-width: 52ch;
  }
  .rad {
    margin: 28px 0;
  }
  .mail {
    font-size: 18px;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 12px 22px;
  }
  .mail:hover {
    border-color: var(--muted);
  }
  .adress {
    font-size: 14px;
    line-height: 1.7;
  }
</style>
