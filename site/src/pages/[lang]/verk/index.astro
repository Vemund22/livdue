---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import VerkStack from '../../../components/VerkStack.astro';
import { KATEGORI_IDS } from '../../../lib/kategorier';
import { LOCALES, UI, catLabel, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = UI[lang];
const alla = await getCollection('verk');
const perKategori = KATEGORI_IDS.map((id) => ({
  id,
  label: catLabel(lang, id),
  verk: alla
    .filter((v) => v.data.kategori === id)
    .sort((a, b) => a.data.ordning - b.data.ordning),
})).filter((k) => k.verk.length > 0);
---

<Layout lang={lang} title={t.nav.verk}>
  <nav class="kategorier" slot="subnav" aria-label={t.nav.verk}>
    {perKategori.map((k) => <a href={`#${k.id}`}>{k.label}</a>)}
  </nav>
  {
    perKategori.map((k, i) => (
      <section id={k.id}>
        <h2>{k.label}</h2>
        <VerkStack verk={k.verk} lang={lang} eager={i === 0 ? 2 : 0} />
      </section>
    ))
  }
</Layout>

<style>
  .kategorier {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 14px;
  }
  .kategorier a {
    color: var(--muted);
  }
  .kategorier a:hover {
    color: var(--text);
  }
  section {
    margin-top: 176px;
  }
  section:first-of-type {
    margin-top: 24px;
  }
  section h2 {
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 56px;
    scroll-margin-top: 140px;
  }
</style>
