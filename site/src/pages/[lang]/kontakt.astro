---
import Layout from '../../layouts/Layout.astro';
import { LOCALES, UI, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = UI[lang];
---

<Layout lang={lang} title={t.contactTitle}>
  <h1>{t.contactTitle}</h1>
  <p>{t.contactBody}</p>
  <p class="rad">
    <a class="mail" href="mailto:livi@livdue.com">livi@livdue.com</a>
  </p>
</Layout>

<style>
  h1 {
    font-size: 22px;
    margin: 8px 0 12px;
  }
  p {
    max-width: 52ch;
  }
  .rad {
    margin: 28px 0;
  }
  .mail {
    font-size: 18px;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 12px 22px;
  }
  .mail:hover {
    border-color: var(--muted);
  }
</style>
