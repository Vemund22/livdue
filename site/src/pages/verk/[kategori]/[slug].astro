---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import { KATEGORIER } from '../../../lib/kategorier';
import { u } from '../../../lib/url';

export async function getStaticPaths() {
  const alla = await getCollection('verk');
  return alla.map((v) => ({
    params: { kategori: v.data.kategori, slug: v.id.split('/').pop() },
    props: { verk: v },
  }));
}

const { verk } = Astro.props;
const { title, kategori, teknik, matt, ar, bild } = verk.data;
const detaljer = [teknik, matt, ar].filter(Boolean).join(' · ');
---

<Layout title={title}>
  <p class="tillbaka">
    <a href={u(`/verk/#${kategori}`)}>&larr; {KATEGORIER[kategori]}</a>
  </p>
  <figure>
    <Image
      src={bild}
      alt={title}
      width={1400}
      widths={[640, 1000, 1400, 2000]}
      sizes="(max-width: 1100px) 96vw, 1052px"
      quality={85}
      loading="eager"
    />
    <figcaption>
      <h1>{title}</h1>
      {detaljer && <p class="muted">{detaljer}</p>}
    </figcaption>
  </figure>
</Layout>

<style>
  .tillbaka {
    font-size: 14px;
    margin: 0 0 20px;
  }
  .tillbaka a {
    color: var(--muted);
  }
  .tillbaka a:hover {
    color: var(--text);
  }
  figure {
    margin: 0;
  }
  figure :global(img) {
    max-height: 82vh;
    width: auto;
    max-width: 100%;
    background: #f1efeb;
  }
  figcaption h1 {
    font-size: 19px;
    margin: 18px 0 2px;
  }
  figcaption p {
    margin: 0;
    font-size: 14px;
  }
</style>
