---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import VerkGrid from '../components/VerkGrid.astro';
import { u } from '../lib/url';

const utvalda = (await getCollection('verk', (v) => v.data.utvald)).sort(
  (a, b) => (a.data.utvaldOrdning ?? 999) - (b.data.utvaldOrdning ?? 999)
);
---

<Layout>
  <p class="intro">måleri, sten, teckning, foto &amp; silver</p>
  <VerkGrid verk={utvalda} eager={3} />
  <p class="more"><a href={u('/verk/')}>Se alla verk &rarr;</a></p>
</Layout>

<style>
  .intro {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 19px;
    color: var(--muted);
    margin: 0 0 28px;
  }
  .more {
    margin-top: 40px;
    font-size: 15px;
  }
  .more a {
    color: var(--muted);
  }
  .more a:hover {
    color: var(--text);
  }
</style>
