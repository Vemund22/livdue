---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { u } from '../lib/url';

const utvalda = (await getCollection('verk', (v) => v.data.utvald)).sort(
  (a, b) => (a.data.utvaldOrdning ?? 999) - (b.data.utvaldOrdning ?? 999)
);
---

<Layout>
  <p class="intro">måleri &middot; skulptur &middot; teckning &middot; foto &middot; silver &middot; film</p>

  <div class="stack">
    {
      utvalda.map((v, i) => (
        <figure>
          <a href={u(`/verk/${v.data.kategori}/${v.id.split('/').pop()}/`)}>
            <Image
              src={v.data.bild}
              alt={v.data.title}
              width={1120}
              widths={[720, 1120, 1520]}
              sizes="(max-width: 820px) 92vw, 760px"
              quality={82}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </a>
          <figcaption>{v.data.title}</figcaption>
        </figure>
      ))
    }
  </div>

  <p class="more"><a href={u('/verk/')}>Se alla verk &rarr;</a></p>
</Layout>

<style>
  .intro {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 19px;
    color: var(--muted);
    margin: 0 0 72px;
  }
  /* Enkolumns-stack, centrerad, mycket luft — ingen kollagekänsla */
  .stack {
    max-width: 760px;
    margin: 0 auto;
  }
  figure {
    margin: 0 0 120px;
    text-align: center;
  }
  figure:last-child {
    margin-bottom: 40px;
  }
  figure :global(img) {
    width: auto;
    max-width: 100%;
    max-height: 88vh;
    margin: 0 auto;
    background: #f1efeb;
  }
  figcaption {
    margin-top: 16px;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  figure a:hover + figcaption,
  figure:hover figcaption {
    color: var(--text);
  }
  .more {
    margin-top: 8px;
    text-align: center;
    font-size: 15px;
  }
  .more a {
    color: var(--muted);
  }
  .more a:hover {
    color: var(--text);
  }
  @media (max-width: 640px) {
    .intro {
      margin-bottom: 48px;
    }
    figure {
      margin-bottom: 80px;
    }
  }
</style>
