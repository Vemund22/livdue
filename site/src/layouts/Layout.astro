---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Liv Due — konstnär. Måleri, foto, skulptur och teckning.' } = Astro.props;
const fullTitle = title ? `${title} — Liv Due` : 'Liv Due — konst';
const path = Astro.url.pathname;
const nav = [
  { href: '/verk/', label: 'Verk' },
  { href: '/om/', label: 'Om' },
  { href: '/kontakt/', label: 'Kontakt' },
];
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header id="sajthuvud">
      <div class="inner">
        <a class="wordmark" href="/">LIV DUE</a>
        <nav>
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>Intresserad av ett verk? Hör av dig.</span>
      <a href="mailto:livi@livdue.com">livi@livdue.com</a>
    </footer>
  </body>
</html>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    transform: translateY(0);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  header.dold {
    transform: translateY(-100%);
  }
  header.svavar {
    box-shadow: 0 1px 0 var(--line);
  }
  .inner {
    max-width: var(--maxw);
    width: 100%;
    margin: 0 auto;
    padding: 36px 24px 28px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    transition: padding 0.25s ease;
  }
  header.svavar .inner {
    padding-top: 14px;
    padding-bottom: 14px;
  }
  @media (prefers-reduced-motion: reduce) {
    header,
    .inner {
      transition: none;
    }
  }
  .wordmark {
    font-size: 20px;
    letter-spacing: 0.3em;
    font-weight: 500;
  }
  nav {
    display: flex;
    gap: 24px;
    font-size: 15px;
  }
  nav a {
    color: var(--muted);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  footer {
    max-width: var(--maxw);
    width: 100%;
    margin: 0 auto;
    padding: 20px 24px 36px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--muted);
  }
  footer a {
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 6px 14px;
  }
  footer a:hover {
    border-color: var(--muted);
  }
</style>

<script is:inline>
  // Headern göms vid scroll neråt och glider in igen vid scroll uppåt
  (() => {
    const header = document.getElementById('sajthuvud');
    let senasteY = window.scrollY;
    const uppdatera = () => {
      const y = window.scrollY;
      header.classList.toggle('svavar', y > 10);
      if (y > 120 && y > senasteY + 4) header.classList.add('dold');
      else if (y < senasteY - 4 || y <= 120) header.classList.remove('dold');
      senasteY = y;
    };
    window.addEventListener('scroll', uppdatera, { passive: true });
    // Tabbar man in i headern ska den alltid synas
    header.addEventListener('focusin', () => header.classList.remove('dold'));
  })();
</script>
