---
import '../styles/global.css';
import { u } from '../lib/url';
import { UI, LOCALES, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  hideFooter?: boolean;
}

const { lang, title, description, hideFooter = false } = Astro.props;
const t = UI[lang];
const year = new Date().getFullYear();
const fullTitle = title ? `${title} — Liv Due` : t.siteTitle;
const desc = description ?? t.metaDesc;
const path = Astro.url.pathname;

const nav = [
  { href: u(`/${lang}/verk/`), label: t.nav.verk },
  { href: u(`/${lang}/om/`), label: t.nav.om },
  { href: u(`/${lang}/kontakt/`), label: t.nav.kontakt },
];

// Nuvarande sida utan språkprefix, för språkväxlare + hreflang
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let rel = path;
if (base && rel.startsWith(base)) rel = rel.slice(base.length);
const rest = rel.replace(new RegExp(`^/${lang}(?=/|$)`), '') || '/';
const langLinks = LOCALES.map((loc) => ({
  loc,
  code: loc.toUpperCase(),
  href: u(`/${loc}${rest === '/' ? '/' : rest}`),
  active: loc === lang,
}));
const alternates = LOCALES.map((loc) => ({
  loc,
  href: new URL(u(`/${loc}${rest === '/' ? '/' : rest}`), Astro.site).toString(),
}));
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.loc} href={a.href} />)}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(u(`/en${rest === '/' ? '/' : rest}`), Astro.site).toString()}
    />
  </head>
  <body>
    <header id="sajthuvud">
      <div class="inner">
        <a class="wordmark" href={u(`/${lang}/`)}>LIV DUE</a>
        <div class="hoger">
          <nav aria-label="Meny">
            {
              nav.map((item) => (
                <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
          </nav>
          <div class="sprak">
            <svg
              class="globe"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18"></path>
              <path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"></path>
            </svg>
            <select id="langsel" aria-label="Language">
              {langLinks.map((l) => (
                <option value={l.href} selected={l.active}>
                  {l.code}
                </option>
              ))}
            </select>
            <svg
              class="chev"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </div>
        </div>
      </div>
      <slot name="subnav" />
    </header>
    <main>
      <slot />
    </main>
    {
      !hideFooter && (
        <footer>
          <span>© {year} Liv Due</span>
          <a href="mailto:livi@livdue.com">livi@livdue.com</a>
        </footer>
      )
    }
  </body>
</html>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    transform: translateY(0);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  header.dold {
    transform: translateY(-100%);
  }
  header.svavar {
    box-shadow: 0 1px 0 var(--line);
  }
  .inner {
    max-width: var(--maxw);
    width: 100%;
    margin: 0 auto;
    padding: 36px 24px 28px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px 28px;
    flex-wrap: wrap;
    transition: padding 0.25s ease;
  }
  header.svavar .inner {
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .hoger {
    display: flex;
    align-items: baseline;
    gap: 28px;
    flex-wrap: wrap;
  }
  @media (prefers-reduced-motion: reduce) {
    header,
    .inner {
      transition: none;
    }
  }
  .wordmark {
    font-size: 28px;
    letter-spacing: 0.2em;
    font-weight: 700;
    color: var(--ink);
    transition: font-size 0.25s ease;
  }
  header.svavar .wordmark {
    font-size: 23px;
  }
  nav {
    display: flex;
    gap: 24px;
    font-size: 15px;
  }
  nav a {
    color: var(--muted);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  .sprak {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--muted);
  }
  .sprak:hover {
    color: var(--text);
  }
  .sprak .globe {
    position: absolute;
    left: 0;
    width: 15px;
    height: 15px;
    pointer-events: none;
  }
  .sprak .chev {
    position: absolute;
    right: 0;
    width: 13px;
    height: 13px;
    pointer-events: none;
  }
  .sprak select {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: none;
    color: inherit;
    font-family: inherit;
    font-size: 13px;
    letter-spacing: 0.08em;
    padding: 4px 18px 4px 22px;
    cursor: pointer;
  }
  .sprak select:focus-visible {
    outline: 1px solid var(--muted);
    outline-offset: 2px;
    border-radius: 4px;
  }
  footer {
    max-width: var(--maxw);
    width: 100%;
    margin: 0 auto;
    padding: 20px 24px 36px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--muted);
  }
  footer a {
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 6px 14px;
  }
  footer a:hover {
    border-color: var(--muted);
  }
</style>

<script is:inline define:vars={{ lang }}>
  // Kom ihåg valt språk så rot-routern respekterar det nästa gång
  try {
    localStorage.setItem('livdue-lang', lang);
  } catch (e) {}
  // Språkval i dropdownen → navigera till samma sida på valt språk
  var _langsel = document.getElementById('langsel');
  if (_langsel)
    _langsel.addEventListener('change', function () {
      if (this.value) window.location.href = this.value;
    });
</script>

<script is:inline>
  // Headern göms vid scroll neråt och glider in igen vid scroll uppåt
  (() => {
    const header = document.getElementById('sajthuvud');
    let senasteY = window.scrollY;
    const uppdatera = () => {
      const y = window.scrollY;
      header.classList.toggle('svavar', y > 10);
      if (y > 120 && y > senasteY + 4) header.classList.add('dold');
      else if (y < senasteY - 4 || y <= 120) header.classList.remove('dold');
      senasteY = y;
    };
    window.addEventListener('scroll', uppdatera, { passive: true });
    header.addEventListener('focusin', () => header.classList.remove('dold'));
  })();
</script>
