---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { u } from '../lib/url';
import type { Locale } from '../lib/i18n';

interface Props {
  verk: CollectionEntry<'verk'>[];
  lang: Locale;
  eager?: number;
}

const { verk, lang, eager = 0 } = Astro.props;
---

<ul class="stack">
  {
    verk.map((v, i) => (
      <li>
        <a href={u(`/${lang}/verk/${v.data.kategori}/${v.id.split('/').pop()}/`)}>
          <Image
            src={v.data.bild}
            alt={v.data.title}
            width={1120}
            widths={[720, 1120, 1520]}
            sizes="(max-width: 820px) 92vw, 760px"
            quality={82}
            loading={i < eager ? 'eager' : 'lazy'}
          />
          <span>{v.data.title}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .stack {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 760px;
  }
  .stack li {
    margin: 0 0 96px;
    text-align: center;
  }
  .stack li:last-child {
    margin-bottom: 0;
  }
  .stack a {
    display: block;
  }
  .stack :global(img) {
    width: auto;
    max-width: 100%;
    max-height: 88vh;
    margin: 0 auto;
    background: #f1efeb;
  }
  .stack span {
    display: block;
    margin-top: 14px;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .stack a:hover span {
    color: var(--text);
  }
  @media (max-width: 640px) {
    .stack li {
      margin-bottom: 64px;
    }
  }
</style>
