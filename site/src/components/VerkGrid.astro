---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { u } from '../lib/url';

interface Props {
  verk: CollectionEntry<'verk'>[];
  eager?: number;
}

const { verk, eager = 0 } = Astro.props;
---

<ul class="grid">
  {
    verk.map((v, i) => (
      <li>
        <a href={u(`/verk/${v.data.kategori}/${v.id.split('/').pop()}/`)}>
          <Image
            src={v.data.bild}
            alt={v.data.title}
            width={640}
            widths={[320, 640, 960]}
            sizes="(max-width: 600px) 92vw, (max-width: 900px) 46vw, 350px"
            quality={80}
            loading={i < eager ? 'eager' : 'lazy'}
          />
          <span>{v.data.title}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* CSS-kolumner ger masonry utan JS — stående och liggande format packas tätt */
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3;
    column-gap: 22px;
  }
  @media (max-width: 900px) {
    .grid {
      columns: 2;
    }
  }
  @media (max-width: 560px) {
    .grid {
      columns: 1;
    }
  }
  .grid li {
    break-inside: avoid;
    margin: 0 0 26px;
  }
  .grid a {
    display: block;
  }
  .grid img {
    width: 100%;
    height: auto;
    background: #f1efeb;
  }
  .grid span {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .grid a:hover span {
    color: var(--text);
  }
</style>
